# ─── Supabase ───
# Obtén estos valores desde: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Service role — SOLO en backend/workers, NUNCA en cliente
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Ambiente ───
# Valores: local | preview | staging | production
APP_ENV=local

# URL publica de la app. Requerida para deep links y staging real.
# En local puede omitirse; el sistema usa http://127.0.0.1:3100 como fallback.
MANZANA_APP_URL=
NEXT_PUBLIC_MANZANA_APP_URL=

# ─── Identidad publica / paquete Meta ───
# Completar antes de reenviar verificacion a Meta. Usar datos reales que
# coincidan con documentos, dominio, correo y telefono publicos.
NEXT_PUBLIC_MANZANA_LEGAL_OPERATOR=
NEXT_PUBLIC_MANZANA_LEGAL_STATUS=
NEXT_PUBLIC_MANZANA_LEGAL_COUNTRY=Peru
NEXT_PUBLIC_MANZANA_PUBLIC_ADDRESS=
NEXT_PUBLIC_MANZANA_CONTACT_EMAIL=
NEXT_PUBLIC_MANZANA_SUPPORT_EMAIL=
NEXT_PUBLIC_MANZANA_PRIVACY_EMAIL=
NEXT_PUBLIC_MANZANA_CONTACT_PHONE=
NEXT_PUBLIC_MANZANA_POLICY_EFFECTIVE_DATE=10 de junio de 2026

# --- WhatsApp V1 - Kapso via WhatsAppAdapter ---
# Kapso es el proveedor operativo V1 aprobado hasta nueva decision.
WHATSAPP_PROVIDER=kapso
KAPSO_API_KEY=
KAPSO_WHATSAPP_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=
# Opcional: solo para tests/staging especiales. Si queda vacio usa https://api.kapso.ai/meta/whatsapp/v24.0.
KAPSO_API_BASE_URL=

# --- WhatsApp legacy adapters ---
# Mantener vacio salvo prueba controlada. YCloud queda reemplazado como proveedor operativo.
YCLOUD_API_KEY=
YCLOUD_WHATSAPP_FROM_PHONE=
YCLOUD_WEBHOOK_SECRET=
YCLOUD_API_BASE_URL=

# --- WhatsApp Meta Cloud API directo - escape tecnico futuro ---
# Mantener vacio salvo que se reabra explicitamente la decision de proveedor.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_VERIFY_TOKEN=
# Alias explicito aceptado por el webhook; puede ser igual a WHATSAPP_VERIFY_TOKEN.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Requerido en staging/production para validar X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# En local se habilita por APP_ENV=local. En staging/production debe activarse
# explicitamente cuando DataAgent/PolicyGate/Response esten aprobados.
WHATSAPP_EXECUTE_READY_ACTIONS=false
# Envio real de respuestas por WhatsApp provider. Mantener false hasta tener
# proveedor/copy aprobados; el orquestador igual deja la respuesta planificada en metadata.
WHATSAPP_SEND_RESPONSES=false
WHATSAPP_SEND_PROACTIVE_NUDGES=false
# Confirmaciones proactivas de movimientos detectados por email. La plantilla
# solo se usa fuera de la ventana de 24 horas y nunca incluye banco ni importe.
WHATSAPP_SEND_EMAIL_PENDING_CONFIRMATIONS=false
WHATSAPP_EMAIL_PENDING_TEMPLATE_NAME=manzana_movimiento_por_confirmar_v1
WHATSAPP_EMAIL_PENDING_TEMPLATE_LANGUAGE=es_PE
# Activar solo después de comprobar estado APPROVED en Meta/Kapso.
WHATSAPP_EMAIL_PENDING_TEMPLATE_APPROVED=false
# off | planned | pilot. No existe modo global en este corte.
WHATSAPP_PROACTIVE_NUDGE_MODE=off
# UUIDs de usuarios separados por coma. Requerido en modo pilot.
WHATSAPP_PROACTIVE_NUDGE_PILOT_USER_IDS=
# Atestaciones operativas. Solo true tras comprobarlas en Meta/Kapso.
WHATSAPP_PROACTIVE_PAYMENT_METHOD_CONFIRMED=false
WHATSAPP_PROACTIVE_TEMPLATE_APPROVED=false
WHATSAPP_NUDGE_TEMPLATE_NAME=
WHATSAPP_NUDGE_TEMPLATE_LANGUAGE=es_PE
# WABA usada para comprobar el estado real de la plantilla en readiness.
KAPSO_WHATSAPP_BUSINESS_ACCOUNT_ID=
# Staging real: procesa el outbox inmediatamente despues de un webhook valido.
# Mantener false si se usa un worker/cron externo.
OUTBOX_AUTO_DRAIN_ON_WEBHOOK=false
OUTBOX_AUTO_DRAIN_LIMIT=10
OUTBOX_AUTO_DRAIN_MAX_PASSES=3
# Requerido para ejecutar /api/internal/workers/outbox fuera de local.
WORKER_SECRET=

# ─── Correo saliente (46, W-19) ───
# Sin RESEND_API_KEY, src/adapters/email/outbound-sender.ts usa
# LoggingEmailSender: registra la intención de envío sin credenciales, no
# falla el resto del sistema, pero no entrega correo real (AC-MAIL-12 queda
# LIVE hasta que el dominio de EMAIL_FROM_ADDRESS este verificado ante el
# proveedor con SPF/DKIM/DMARC).
RESEND_API_KEY=
# "Nombre <correo@dominio-verificado>". Sin esto, cae a
# onboarding@resend.dev (remitente de prueba de Resend: solo entrega a la
# cuenta propia, nunca sirve para usuarios reales).
EMAIL_FROM_ADDRESS=
# Firma HMAC de /baja (46 RUL-MAIL-04). Sin configurar, cae a
# SUPABASE_SERVICE_ROLE_KEY como secreto — funciona, pero un secreto propio
# permite rotarlo sin afectar la base de datos.
EMAIL_UNSUBSCRIBE_SECRET=
# Firma del webhook de rebotes/quejas del proveedor de correo
# (/api/webhooks/email). Sin configurar, la ruta rechaza todo fuera de
# APP_ENV=local — no hay valor por defecto seguro para un webhook publico.
EMAIL_WEBHOOK_SECRET=
# Requerido para ejecutar /api/internal/workers/email-outbox y
# /api/internal/jobs/exports-process fuera de local (mismo secreto que
# WORKER_SECRET/CRON_SECRET de arriba; documentado aqui para que quien
# configure el scheduler externo de estos dos jobs nuevos los encuentre).

# ─── AgentRuntime ───
# local_fixture | codex | api
# En local/tests se conserva local_fixture. En preview/staging/production queda
# prohibido aunque se configure por error; el runtime falla cerrado.
# Para mover agentes uno por uno:
# AGENT_RUNTIME_DATA_AGENT_PROVIDER=api
# AGENT_RUNTIME_EMAIL_EXTRACTION_AGENT_PROVIDER=api despues de consentimiento
# y activacion institucional shadow
# AGENT_RUNTIME_RESPONSE_AGENT_PROVIDER=api despues de smoke controlado
AGENT_RUNTIME_DEFAULT_PROVIDER=local_fixture
# Solo tiene efecto en APP_ENV=local o NODE_ENV=test. Fuera de local el
# fallback efectivo siempre es false y readiness reporta la configuracion.
AGENT_RUNTIME_FALLBACK_LOCAL=true
AGENT_RUNTIME_CONVERSATIONAL_EXECUTIVE_AGENT_PROVIDER=
# off | shadow | active. Mantener shadow hasta superar los gates B; active
# elimina las llamadas LLM independientes de planner/data/correction/response.
CONVERSATIONAL_EXECUTIVE_MODE=shadow
AGENT_RUNTIME_DATA_AGENT_PROVIDER=
AGENT_RUNTIME_EMAIL_EXTRACTION_AGENT_PROVIDER=
AGENT_RUNTIME_RESPONSE_AGENT_PROVIDER=
AGENT_RUNTIME_CONVERSATION_AGENT_PROVIDER=
AGENT_RUNTIME_CORRECTION_AGENT_PROVIDER=
AGENT_RUNTIME_DATA_AGENT_TIMEOUT_MS=10000
AGENT_RUNTIME_EMAIL_EXTRACTION_AGENT_TIMEOUT_MS=20000
AGENT_RUNTIME_RESPONSE_AGENT_TIMEOUT_MS=10000
AGENT_RUNTIME_CONVERSATION_AGENT_TIMEOUT_MS=20000
AGENT_RUNTIME_CORRECTION_AGENT_TIMEOUT_MS=15000
AGENT_RUNTIME_CONVERSATIONAL_EXECUTIVE_AGENT_TIMEOUT_MS=25000
# Coordina recorridos de varios pasos. No recibe acceso SQL ni puede ejecutar
# movimientos: solo propone ExecutionPlan validado por FinancialOrchestrator.
AGENT_RUNTIME_ORCHESTRATION_PLANNING_AGENT_PROVIDER=
AGENT_RUNTIME_ORCHESTRATION_PLANNING_AGENT_TIMEOUT_MS=15000
AGENT_RUNTIME_LEARNING_SIGNAL_AGENT_PROVIDER=
AGENT_RUNTIME_LEARNING_SIGNAL_AGENT_TIMEOUT_MS=12000
AGENT_RUNTIME_RISK_SIGNAL_AGENT_PROVIDER=
AGENT_RUNTIME_RISK_SIGNAL_AGENT_TIMEOUT_MS=10000
AGENT_RUNTIME_DEDUP_SIGNAL_AGENT_PROVIDER=
AGENT_RUNTIME_DEDUP_SIGNAL_AGENT_TIMEOUT_MS=8000
AGENT_RUNTIME_DISCLOSURE_EXPERIENCE_AGENT_PROVIDER=
AGENT_RUNTIME_RECURRING_SIGNAL_AGENT_PROVIDER=
AGENT_RUNTIME_NUDGE_EXPERIENCE_AGENT_PROVIDER=
AGENT_RUNTIME_INSIGHT_EXPERIENCE_AGENT_PROVIDER=
AGENT_RUNTIME_INSIGHT_NARRATOR_AGENT_PROVIDER=
AGENT_RUNTIME_DISCLOSURE_EXPERIENCE_AGENT_TIMEOUT_MS=8000
AGENT_RUNTIME_RECURRING_SIGNAL_AGENT_TIMEOUT_MS=8000
AGENT_RUNTIME_NUDGE_EXPERIENCE_AGENT_TIMEOUT_MS=8000
AGENT_RUNTIME_INSIGHT_EXPERIENCE_AGENT_TIMEOUT_MS=10000
AGENT_RUNTIME_INSIGHT_NARRATOR_AGENT_TIMEOUT_MS=8000
# http | openai. Si queda vacio, usa openai cuando exista OPENAI_API_KEY
# y no haya AGENT_RUNTIME_API_URL; usa http cuando haya endpoint propio.
AGENT_RUNTIME_API_KIND=
AGENT_RUNTIME_API_URL=
AGENT_RUNTIME_API_TOKEN=
# Requerido si AGENT_RUNTIME_API_KIND=openai.
AGENT_RUNTIME_API_MODEL=
# Alternativa a AGENT_RUNTIME_API_TOKEN para OpenAI Responses API.
OPENAI_API_KEY=
AGENT_RUNTIME_CODEX_URL=
AGENT_RUNTIME_CODEX_TOKEN=
AGENT_RUNTIME_CODEX_MODEL=

# ─── Gmail / Google OAuth ───
# Completar en Corte 9
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Topic completo: projects/PROJECT_ID/topics/TOPIC_ID.
GMAIL_PUBSUB_TOPIC=
# 32 bytes aleatorios codificados en base64. Solo backend.
GMAIL_TOKEN_ENCRYPTION_KEY=
# URL exacta configurada como audience del push autenticado.
GMAIL_PUBSUB_AUDIENCE=
# Service account usada por la suscripcion push OIDC.
GMAIL_PUBSUB_SERVICE_ACCOUNT=

# ─── Observabilidad (opcional en local) ───
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
